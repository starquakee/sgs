      "file": "audio/skill/luansuo1.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 鸾锁",
      "text": "六道锁凡尘，死生皆如逆旅。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/luansuo1.mp3",
