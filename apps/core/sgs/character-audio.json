      "sha256": "7d92bf71458cf4a79dbc46f42f9f6d80dc5f699c370e6b68a46ceffeb0bcddeb"
    },
    "skill/dcjuchui1": {
      "key": "skill/dcjuchui1",
      "file": "audio/skill/dcjuchui1.mp3",
      "character": "v_dongzhuo",
      "label": "威董卓 · 据陲",
      "text": "我不击金柝，胡月何敢升！",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcjuchui1.mp3",
      "sourceGitBlob": "4fb9cb59cdfab9d81f1c42e99b158104a7b9acbb",
      "bytes": 77732,
      "sha256": "5cbf2e86f45fb752a02174fe7b88b2c5ce44328f27999a8a3d4d166023e9e588"
    },
    "skill/dcjuchui2": {
      "key": "skill/dcjuchui2",
      "file": "audio/skill/dcjuchui2.mp3",
      "character": "v_dongzhuo",
      "label": "威董卓 · 据陲",
      "text": "这千里凉州，我董卓便是天！",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcjuchui2.mp3",
      "sourceGitBlob": "7984c61c1f3120161f729f874b541e7302fe4bd0",
      "bytes": 81452,
      "sha256": "5408b45ef9f44357d56422e71f2ba77189837f709bc5d5c5c4888d67dd3f73b6"
    },
    "die/v_dongzhuo": {
      "key": "die/v_dongzhuo",
      "file": "audio/die/v_dongzhuo.mp3",
      "character": "v_dongzhuo",
      "label": "威董卓 · 阵亡",
      "text": "半生戎马，不及门阀一语。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/die/v_dongzhuo.mp3",
