      "sha256": "da59188e16886a6d995bf89e1cca9c1803796e9d67e2afedef7fb2a760be6310"
    },
    "skill/luansuo2": {
      "key": "skill/luansuo2",
      "file": "audio/skill/luansuo2.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 鸾锁",
      "text": "命数如织网，无人不坠因果。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/luansuo2.mp3",
      "sourceGitBlob": "94202738672cd23de6b54e4dbd879052ca21e5f2",
      "bytes": 170819,
      "sha256": "730b323a0b87381afee9f59b64dde6f4725e7ab87b8756f3132c6d8223936d99"
    },
    "skill/fengliao1": {
      "key": "skill/fengliao1",
      "file": "audio/skill/fengliao1.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 凤燎",
      "text": "乘丹凤者，不堪其炙，何堪其远？",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/fengliao1.mp3",
      "sourceGitBlob": "d60bee888d644c08c1928d02ce267d64a7f9cbbf",
      "bytes": 203699,
      "sha256": "45fdfa34480ba0ca8af00a9b4b1d5a6ed44e4b62a9a2c7f3d590df25cbf0ab7d"
    },
    "skill/fengliao2": {
      "key": "skill/fengliao2",
      "file": "audio/skill/fengliao2.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 凤燎",
      "text": "我以天地为炉，诸君敢入局否？",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/fengliao2.mp3",
      "sourceGitBlob": "47e80a6fb0c7b0e14a72d825c4f7dc01032ab1ce",
      "bytes": 248579,
      "sha256": "8a1355ccec928a8bb57b573c8158f43b693323acb44a9dd81613ea758fcd6b43"
    },
    "skill/kunyu1": {
      "key": "skill/kunyu1",
      "file": "audio/skill/kunyu1.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 鹍浴",
      "text": "君岂不闻，山皆有其愚公乎？",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/kunyu1.mp3",
      "sourceGitBlob": "23b4154627f329175e74f054f5613319c3eab5ef",
      "bytes": 177587,
      "sha256": "acea555f3aece4a33640971002917a34580d9a8270707625b84ddc05998db7e7"
    },
    "skill/kunyu2": {
      "key": "skill/kunyu2",
      "file": "audio/skill/kunyu2.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 鹍浴",
      "text": "衰桐凤不栖，昆山玉已碎！",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/kunyu2.mp3",
      "sourceGitBlob": "5234aaf64d8db984ea3571a780b7e1ea011a93f0",
      "bytes": 163907,
      "sha256": "a1a76df8c313c9ec38ca38087a32aec74ef2ad786ec207c68ee0ea855e2dabd1"
    },
    "die/shen_pangtong": {
      "key": "die/shen_pangtong",
      "file": "audio/die/shen_pangtong.mp3",
      "character": "shen_pangtong",
      "label": "神庞统 · 阵亡",
      "text": "心怀英雄志，何堪寂寥乡。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/die/shen_pangtong.mp3",
      "sourceGitBlob": "f81149c784b2bdef52e4a460df7d991fc5e34a71",
      "bytes": 211523,
      "sha256": "2924d41ee307776dda4e846f26b2e53f3a5bd2579475aedd7bb12dc83cf80147"
    },
    "skill/dcsbbizuo1": {
      "key": "skill/dcsbbizuo1",
      "file": "audio/skill/dcsbbizuo1.mp3",
      "character": "dc_sb_xunyu",
      "label": "新杀谋荀彧 · 弼佐",
      "text": "君同日月，国若山河，吾不敢舍昼夜。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcsbbizuo1.mp3",
      "sourceGitBlob": "aa2852abd6d929142a4581e8be0fe80090a7de32",
      "bytes": 84212,
      "sha256": "796062ffa76e023e39d659161d4132e54a3ac1dbd1f0a0b617d0ea74d93cf2f2"
    },
    "skill/dcsbbizuo2": {
      "key": "skill/dcsbbizuo2",
      "file": "audio/skill/dcsbbizuo2.mp3",
      "character": "dc_sb_xunyu",
      "label": "新杀谋荀彧 · 弼佐",
      "text": "人生百载，或死利，或死欲，死义可乎。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcsbbizuo2.mp3",
      "sourceGitBlob": "cdb4808f2799b9d35f2110b95ba13d53a5397139",
      "bytes": 93764,
      "sha256": "6fa1c12d1bcc58b9644d64716eb4b3171428d10bb1f4150e705aa53d6a2b5724"
    },
    "skill/dcsbshimou1": {
      "key": "skill/dcsbshimou1",
      "file": "audio/skill/dcsbshimou1.mp3",
      "character": "dc_sb_xunyu",
      "label": "新杀谋荀彧 · 势谋",
      "text": "臣未寒在胸之血，君何吝雨露雷霆。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcsbshimou1.mp3",
      "sourceGitBlob": "5343fcf2872642f11b412a714d00607aabb836af",
      "bytes": 73700,
      "sha256": "11574fb2963ff34c00bc924991552a9e413f52e85fbe55207810d4c599553466"
    },
    "skill/dcsbshimou2": {
      "key": "skill/dcsbshimou2",
      "file": "audio/skill/dcsbshimou2.mp3",
      "character": "dc_sb_xunyu",
      "label": "新杀谋荀彧 · 势谋",
      "text": "龙困浅滩，尚需云雨为济，况天子乎？",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcsbshimou2.mp3",
      "sourceGitBlob": "4d646d556a77a1899a564baac008c04a53d1a44c",
      "bytes": 74588,
      "sha256": "2cebd7ae62f0f95a6eda10c31c0b399d7eed83d8ef30a68f4e8fea52f26a02d8"
    },
    "die/dc_sb_xunyu": {
      "key": "die/dc_sb_xunyu",
      "file": "audio/die/dc_sb_xunyu.mp3",
      "character": "dc_sb_xunyu",
      "label": "新杀谋荀彧 · 阵亡",
      "text": "诸君见我冢，亦如见青山。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/die/dc_sb_xunyu.mp3",
      "sourceGitBlob": "99c3cc2abe576e94c2576a06b6709ec677d35648",
      "bytes": 60956,
      "sha256": "d26a68d52d4373ec900745bd2472e79a2d45e16cd508e523b1ff47600c98830d"
    },
    "skill/dcsbbizuo_dc_sb_xunyu_shadow1": {
      "key": "skill/dcsbbizuo_dc_sb_xunyu_shadow1",
      "file": "audio/skill/dcsbbizuo_dc_sb_xunyu_shadow1.mp3",
      "character": "dc_sb_xunyu",
      "label": "新杀谋荀彧（转换形态） · 弼佐",
      "text": "而今江山未靖，劝君择日称功。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcsbbizuo_dc_sb_xunyu_shadow1.mp3",
