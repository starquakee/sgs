      "bytes": 84068,
      "sha256": "15bd8f99627d9c612be78f4dce888ddbb716e288bd7cca9a77a85d1ab525ab95"
    },
    "skill/dcguangyong2": {
      "key": "skill/dcguangyong2",
      "file": "audio/skill/dcguangyong2.mp3",
      "character": "v_dongzhuo",
      "label": "威董卓 · 犷勇",
      "text": "掷酒湟水，我来宴无定河边骨。",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcguangyong2.mp3",
