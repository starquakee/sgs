      "character": "v_dongzhuo",
      "label": "威董卓 · 犷勇",
      "text": "孤烟直上，黄沙漫卷祁连天！",
      "sourceUrl": "https://raw.githubusercontent.com/libnoname/noname/7fcf23ed54d8a7ce2b49ae2c15a054123891a52a/apps/core/audio/skill/dcguangyong1.mp3",
